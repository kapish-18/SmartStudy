<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1050.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartstudy.javafx.controller.SubjectController">
   <left>
      <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar">
         <padding>
            <Insets bottom="20.0" left="16.0" right="16.0" top="24.0" />
         </padding>
         <children>
            <Label styleClass="app-title" text="⚡ SmartStudy" />
            <Label styleClass="text-muted" text="Academic Management" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="20.0" />
               </padding>
               <children>
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToDashboard" styleClass="nav-btn" text="📊 Dashboard" />
                  <Button maxWidth="1.7976931348623157E308" styleClass="nav-btn-active" text="📚 Subjects" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToTasks" styleClass="nav-btn" text="📝 Tasks &amp; To-Dos" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToExams" styleClass="nav-btn" text="🎯 Exams &amp; Marks" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToStudy" styleClass="nav-btn" text="⏱ Study Tracker" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToProgress" styleClass="nav-btn" text="📈 Progress Analytics" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="20.0" styleClass="content-pane">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="📚 Subject Management" />
                  <Label styleClass="text-muted" text="Maintain enrolled courses, credits, and target marks (demonstrates HashMap lookup)" />
               </children>
            </VBox>

            <!-- Add Subject Form Card -->
            <VBox spacing="14.0" styleClass="card">
               <children>
                  <Label styleClass="section-title" text="➕ Add New Subject" />
                  <HBox spacing="12.0">
                     <children>
                        <TextField fx:id="nameField" promptText="Subject Name (e.g., Computer Networks)" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="codeField" prefWidth="140.0" promptText="Code (CSE3004)" />
                        <TextField fx:id="creditsField" prefWidth="100.0" promptText="Credits (3)" />
                        <TextField fx:id="targetMarksField" prefWidth="140.0" promptText="Target % (85)" />
                        <Button onAction="#handleAddSubject" styleClass="btn-primary" text="Add Subject" />
                     </children>
                  </HBox>
                  <Label fx:id="statusLabel" text="" />
               </children>
            </VBox>

            <!-- Table Card -->
            <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="section-title" text="Current Enrolled Subjects" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleDeleteSubject" styleClass="btn-danger" text="🗑 Delete Selected" />
                     </children>
                  </HBox>

                  <TableView fx:id="subjectTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="300.0" text="Subject Name" />
                        <TableColumn fx:id="colCode" prefWidth="140.0" text="Course Code" />
                        <TableColumn fx:id="colCredits" prefWidth="100.0" text="Credits" />
                        <TableColumn fx:id="colTargetMarks" prefWidth="140.0" text="Target Marks (%)" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
