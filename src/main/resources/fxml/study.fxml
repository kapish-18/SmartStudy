<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1050.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartstudy.javafx.controller.StudyController">
   <left>
      <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar">
         <padding>
            <Insets bottom="20.0" left="16.0" right="16.0" top="24.0" />
         </padding>
         <children>
            <Label styleClass="app-title" text="⚡ SmartStudy" />
            <Label styleClass="text-muted" text="Academic Management" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="20.0" />
               </padding>
               <children>
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToDashboard" styleClass="nav-btn" text="📊 Dashboard" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToSubjects" styleClass="nav-btn" text="📚 Subjects" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToTasks" styleClass="nav-btn" text="📝 Tasks &amp; To-Dos" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToExams" styleClass="nav-btn" text="🎯 Exams &amp; Marks" />
                  <Button maxWidth="1.7976931348623157E308" styleClass="nav-btn-active" text="⏱ Study Tracker" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToProgress" styleClass="nav-btn" text="📈 Progress Analytics" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="18.0" styleClass="content-pane">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="⏱ Study Session Tracker" />
                  <Label styleClass="text-muted" text="Record study time, topics covered, and track study consistency" />
               </children>
            </VBox>

            <!-- Total Study Hours summary card -->
            <VBox styleClass="card-stat">
               <children>
                  <Label fx:id="totalHoursLabel" styleClass="stat-value-emerald" text="Total Recorded Study Time: 0 hrs" />
               </children>
            </VBox>

            <!-- Log Study Session Form -->
            <VBox spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="section-title" text="➕ Log Study Session" />
                  <HBox spacing="10.0">
                     <children>
                        <ComboBox fx:id="subjectComboBox" prefWidth="250.0" promptText="Select Subject" />
                        <TextField fx:id="topicField" promptText="Topic / Chapter (e.g. Dynamic Programming Knapsack)" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="durationField" prefWidth="150.0" promptText="Minutes (e.g. 45)" />
                        <!-- Quick presets -->
                        <Button onAction="#setPomodoro" styleClass="btn-secondary" text="25m (Pomodoro)" />
                        <Button onAction="#setHour" styleClass="btn-secondary" text="60m (1 hr)" />
                        <Button onAction="#setHourAndHalf" styleClass="btn-secondary" text="90m (1.5 hr)" />
                        <DatePicker fx:id="sessionDatePicker" prefWidth="170.0" />
                        <Button onAction="#handleRecordSession" styleClass="btn-primary" text="Log Session" />
                     </children>
                  </HBox>
                  <Label fx:id="statusLabel" text="" />
               </children>
            </VBox>

            <!-- Session History Table -->
            <VBox spacing="12.0" VBox.vgrow="ALWAYS" styleClass="card">
               <children>
                  <Label styleClass="section-title" text="Study Log History" />
                  <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colSubject" prefWidth="260.0" text="Subject" />
                        <TableColumn fx:id="colTopic" prefWidth="320.0" text="Topic / Concept" />
                        <TableColumn fx:id="colDuration" prefWidth="130.0" text="Duration (Mins)" />
                        <TableColumn fx:id="colDate" prefWidth="140.0" text="Date" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
