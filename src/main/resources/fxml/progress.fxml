<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1050.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartstudy.javafx.controller.ProgressController">
   <left>
      <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar">
         <padding>
            <Insets bottom="20.0" left="16.0" right="16.0" top="24.0" />
         </padding>
         <children>
            <Label styleClass="app-title" text="⚡ SmartStudy" />
            <Label styleClass="text-muted" text="Academic Management" />
            
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="20.0" />
               </padding>
               <children>
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToDashboard" styleClass="nav-btn" text="📊 Dashboard" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToSubjects" styleClass="nav-btn" text="📚 Subjects" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToTasks" styleClass="nav-btn" text="📝 Tasks &amp; To-Dos" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToExams" styleClass="nav-btn" text="🎯 Exams &amp; Marks" />
                  <Button maxWidth="1.7976931348623157E308" onAction="#navToStudy" styleClass="nav-btn" text="⏱ Study Tracker" />
                  <Button maxWidth="1.7976931348623157E308" styleClass="nav-btn-active" text="📈 Progress Analytics" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <center>
      <ScrollPane fitToWidth="true" style="-fx-background: #0F172A; -fx-background-color: transparent;">
         <content>
            <VBox spacing="20.0" styleClass="content-pane">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="📈 Academic Progress &amp; Analytics" />
                        <Label styleClass="text-muted" text="Subject-wise tracking, completion ratios, and unique topics studied (demonstrates HashSet)" />
                     </children>
                  </VBox>

                  <!-- Overall Progress Card -->
                  <VBox spacing="14.0" styleClass="card">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="section-title" text="Overall Academic Completion" HBox.hgrow="ALWAYS" />
                              <Label fx:id="overallProgressValueLabel" styleClass="stat-value" text="0%" />
                           </children>
                        </HBox>
                        <ProgressBar fx:id="overallProgressBar" maxWidth="1.7976931348623157E308" prefHeight="16.0" />
                        <HBox spacing="24.0">
                           <children>
                              <Label fx:id="totalHoursValueLabel" styleClass="text-muted" text="0 Hours Logged" />
                              <Label fx:id="uniqueTopicsCountLabel" styleClass="text-muted" text="0 Unique Topics" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Subject-wise Breakdown -->
                  <VBox spacing="12.0">
                     <children>
                        <Label styleClass="section-title" text="Course Breakdown &amp; Target Comparison" />
                        <VBox fx:id="subjectProgressContainer" spacing="12.0" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
