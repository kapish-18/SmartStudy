<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="650.0" prefWidth="950.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartstudy.javafx.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="440.0" spacing="20.0" styleClass="card">
         <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
         </padding>
         <children>
            <!-- Logo / Brand Title -->
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="app-title" text="⚡ SmartStudy" />
                  <Label styleClass="text-muted" text="Intelligent Academic Planning &amp; Progress Management" />
               </children>
            </VBox>

            <!-- Login Form Fields -->
            <VBox spacing="14.0">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="text-muted" text="Student / Teacher Email" />
                        <TextField fx:id="emailField" promptText="alex@smartstudy.edu" text="alex@smartstudy.edu" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="text-muted" text="Password" />
                        <PasswordField fx:id="passwordField" promptText="Enter password" text="pass123" />
                     </children>
                  </VBox>

                  <Label fx:id="errorLabel" wrapText="true" />

                  <Button maxWidth="1.7976931348623157E308" onAction="#handleLogin" prefHeight="42.0" styleClass="btn-primary" text="Sign In to SmartStudy" />
               </children>
            </VBox>

            <!-- Quick Demo One-Click Access -->
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label styleClass="text-muted" text="── Quick Evaluation Demo ──" />
                  <HBox alignment="CENTER" spacing="12.0">
                     <children>
                        <Button onAction="#handleQuickDemoStudent" styleClass="btn-secondary" text="Demo Student Login" />
                        <Button onAction="#handleQuickDemoTeacher" styleClass="btn-secondary" text="Demo Teacher Login" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</StackPane>
